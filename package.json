{
  "name": "roman-bondarchuk-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "next build",
    "build:all": "bash scripts/build-all.sh",
    "resume:en": ".venv-resume/bin/python3 scripts/generate-resume-en-docx.py",
    "start": "next start",
    "serve": "npx --yes serve dist -l 3000",
    "pack": "rm -f site.zip && cd dist && zip -qr ../site.zip . -x '*.DS_Store' && echo '✓ site.zip ready'"
  },
  "dependencies": {
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
