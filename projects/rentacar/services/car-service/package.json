    "@nestjs/platform-express": "^11.1.2",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.19.3",
    "@rentacar/prisma": "*",
    "@rentacar/shared-types": "*",
    "@rentacar/shared-utils": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
