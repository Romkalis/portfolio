# ─── Global ─────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL (per-service URLs in docker-compose) ───
POSTGRES_USER=rentacar
POSTGRES_PASSWORD=rentacar
POSTGRES_HOST=localhost

AUTH_DATABASE_URL=postgresql://rentacar:rentacar@localhost:5434/rentacar_auth?schema=public
CAR_DATABASE_URL=postgresql://rentacar:rentacar@localhost:5434/rentacar_car?schema=public
BOOKING_DATABASE_URL=postgresql://rentacar:rentacar@localhost:5434/rentacar_booking?schema=public

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_URL=amqp://rentacar:rentacar@localhost:5672
RABBITMQ_USER=rentacar
RABBITMQ_PASSWORD=rentacar

# ─── JWT (auth-service) ───────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── OAuth (auth-service) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ─── Services ports ───────────────────────────────────────
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
CAR_SERVICE_PORT=3002
BOOKING_SERVICE_PORT=3003
CAR_SERVICE_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3003
AUTH_SERVICE_URL=http://localhost:3001
CAR_SERVICE_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3003

# ─── Internal security (production: strong random values) ─
INTERNAL_API_KEY=dev-internal-key-change-in-production
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-in-production

# ─── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
